# ResQGrid Backend Environment Configuration Example
# Copy to backend/.env or configure in Render/Railway/Fly.io settings

# Environment name: development | production
ENVIRONMENT=development

# Database connection URL
# Default local SQLite:
DATABASE_URL=sqlite:///./resqgrid.db

# Hosted PostgreSQL / Supabase example (set in your cloud host):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# CORS Allowed Origins (Comma separated or json array)
CORS_ORIGINS=["http://localhost:5173","https://resqgrid.vercel.app","*"]

# Optional Supabase credentials when enabling Supabase Auth / Storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...[PLACEHOLDER_KEY]

# Demo Mode toggle (seeds demonstration scenario data automatically)
DEMO_MODE=True
